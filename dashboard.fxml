<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="DashboardController"
            prefWidth="1200"
            prefHeight="750"
            styleClass="root">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="220"
              spacing="20"
              styleClass="sidebar"
              alignment="TOP_CENTER">

            <padding>
                <Insets top="30" right="15" bottom="20" left="15"/>
            </padding>

            <!-- LOGO -->
            <ImageView fitWidth="120"
                       fitHeight="120"
                       preserveRatio="true"
                       smooth="false"
                       cache="false">
                <image>
                    <Image url="file:pantrypal-logo.png"/>
                           
                </image>
            </ImageView>

            <Label text="PantryPal" styleClass="app-title"/>
            <Label text="YOUR SMART KITCHEN" styleClass="app-subtitle"/>

            <Separator/>

            <!-- NAVIGATION -->
            <Button text="Dashboard"
                    onAction="#showDashboard"
                    maxWidth="Infinity"
                    styleClass="nav-button">
                <graphic>
                    <Label text="⌂" styleClass="nav-icon"/>
                </graphic>
            </Button>

            <Button text="Pantry"
                    onAction="#showPantry"
                    maxWidth="Infinity"
                    styleClass="nav-button">
                <graphic>
                    <Label text="▦" styleClass="nav-icon"/>
                </graphic>
            </Button>

            <Button text="Shopping List"
                    onAction="#showShopping"
                    maxWidth="Infinity"
                    styleClass="nav-button">
                <graphic>
                    <Label text="🛒" styleClass="nav-icon"/>
                </graphic>
            </Button>

            <Button text="Recipes"
                    onAction="#showRecipes"
                    maxWidth="Infinity"
                    styleClass="nav-button">
                <graphic>
                    <Label text="♨" styleClass="nav-icon"/>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="PantryPal v1.0"
                   styleClass="sidebar-footer"/>

        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane>

            <!-- DASHBOARD SECTION -->
            <VBox fx:id="dashboardSection"
                  spacing="22"
                  visible="true"
                  managed="true">

                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>

                <!-- WELCOME HEADER -->
                <VBox spacing="8">
                    <Label text="Welcome to PantryPal 🍛"
                           styleClass="page-title"/>

                    <Label text="Your Kitchen, Intelligently Organised."
                           styleClass="page-description"/>
                </VBox>

                <!-- STATISTICS -->
<HBox spacing="15" alignment="CENTER">

    <!-- TOTAL ITEMS -->
    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
        <Label text="📦" styleClass="stat-icon, icon-green"/>
        <Label text="TOTAL ITEMS"/>
        <Label fx:id="totalItemsLabel"
               text="0"
               styleClass="stat-number"/>
        <Label text="Items in your pantry"/>
    </VBox>

    <!-- LOW STOCK -->
    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
        <Label text="!" styleClass="stat-icon, icon-amber"/>
        <Label text="LOW STOCK"/>
        <Label fx:id="lowStockLabel"
               text="0"
               styleClass="stat-number"/>
        <Label text="Need replenishment"/>
    </VBox>

    <!-- OUT OF STOCK -->
    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
        <Label text="🔴" styleClass="stat-icon, icon-red"/>
        <Label text="OUT OF STOCK"/>
        <Label fx:id="outOfStockLabel"
               text="0"
               styleClass="stat-number"/>
        <Label text="Items unavailable"/>
    </VBox>

    <!-- EXPIRED -->
    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
        <Label text="📅" styleClass="stat-icon, icon-purple"/>
        <Label text="EXPIRED"/>
        <Label fx:id="expiredLabel"
               text="0"
               styleClass="stat-number"/>
        <Label text="Past expiry date"/>
    </VBox>

    <!-- EXPIRING SOON -->
    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
        <Label text="🌿" styleClass="stat-icon, icon-leaf"/>
        <Label text="EXPIRING SOON"/>
        <Label fx:id="expiringSoonLabel"
               text="0"
               styleClass="stat-number"/>
        <Label text="Use these items soon"/>
    </VBox>

</HBox>

                <!-- PANTRY OVERVIEW HEADER -->
                <HBox alignment="CENTER_LEFT" spacing="10">

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Pantry Overview"
                               styleClass="section-title"/>

                        <Label text="Keep track of everything in your kitchen."
                               styleClass="page-description"/>
                    </VBox>

                    <Button text="↻ Refresh"
                            onAction="#refreshDashboard"
                            styleClass="action-button"/>

                </HBox>

                <!-- PANTRY TABLE -->
                <TableView fx:id="pantryTable"
                           VBox.vgrow="ALWAYS">

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                    <columns>

                        <TableColumn fx:id="idColumn"
                                     text="ID"
                                     prefWidth="55"/>

                        <TableColumn fx:id="nameColumn"
                                     text="Item Name"
                                     prefWidth="150"/>

                        <TableColumn fx:id="categoryColumn"
                                     text="Category"
                                     prefWidth="120"/>

                        <TableColumn fx:id="quantityColumn"
                                     text="Quantity"
                                     prefWidth="100"/>

                        <TableColumn fx:id="unitColumn"
                                     text="Unit"
                                     prefWidth="80"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="150"/>

                    </columns>

                </TableView>

            </VBox>

            <!-- PANTRY SECTION -->
            <VBox fx:id="pantrySection"
                  spacing="15"
                  visible="false"
                  managed="false">

                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>

                <Label text="Pantry Management"
                       styleClass="page-title"/>

                <Label text="Add, update, search and manage pantry items."
                       styleClass="page-description"/>

                <GridPane hgap="10" vgap="10">

                    <Label text="Item Name"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="itemNameField"
                               promptText="Enter item name"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                    <Label text="Category"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="2"/>

                    <TextField fx:id="categoryField"
                               promptText="Enter category"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="3"/>

                    <Label text="Quantity"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="quantityField"
                               promptText="Enter quantity"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                    <Label text="Unit"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="2"/>

                    <TextField fx:id="unitField"
                               promptText="kg, litres, pieces..."
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="3"/>

                    <Label text="Expiry Date"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"/>

                    <DatePicker fx:id="expiryDatePicker"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="1"/>

                    <Label text="Minimum Stock"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="2"/>

                    <TextField fx:id="minimumStockField"
                               promptText="Minimum quantity"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="3"/>

                </GridPane>

                <HBox spacing="10">

                    <Button text="Add Item"
                            onAction="#addPantryItem"
                            styleClass="action-button"/>

                    <Button text="Update Selected"
                            onAction="#updatePantryItem"
                            styleClass="action-button"/>

                    <Button text="Delete Selected"
                            onAction="#deleteSelectedItem"
                            styleClass="delete-button"/>

                    <Button text="Clear"
                            onAction="#clearPantryFields"
                            styleClass="action-button"/>

                </HBox>

                <HBox spacing="10">

                    <TextField fx:id="searchField"
                               promptText="Search pantry items..."/>

                    <Button text="Search"
                            onAction="#searchPantry"
                            styleClass="action-button"/>

                    <Button text="Show All"
                            onAction="#refreshPantry"
                            styleClass="action-button"/>

                </HBox>

                <TableView fx:id="managementPantryTable"
                           VBox.vgrow="ALWAYS">

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                    <columns>

                        <TableColumn fx:id="manageIdColumn"
                                     text="ID"
                                     prefWidth="50"/>

                        <TableColumn fx:id="manageNameColumn"
                                     text="Item Name"
                                     prefWidth="130"/>

                        <TableColumn fx:id="manageCategoryColumn"
                                     text="Category"
                                     prefWidth="110"/>

                        <TableColumn fx:id="manageQuantityColumn"
                                     text="Quantity"
                                     prefWidth="90"/>

                        <TableColumn fx:id="manageUnitColumn"
                                     text="Unit"
                                     prefWidth="70"/>

                        <TableColumn fx:id="expiryColumn"
                                     text="Expiry Date"
                                     prefWidth="120"/>

                        <TableColumn fx:id="manageStatusColumn"
                                     text="Status"
                                     prefWidth="130"/>

                    </columns>

                </TableView>

            </VBox>

            <!-- SHOPPING LIST SECTION -->
            <VBox fx:id="shoppingSection"
                  spacing="20"
                  visible="false"
                  managed="false">

                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>

                <Label text="Shopping List"
                       styleClass="page-title"/>

                <Label text="Manage the items you need to purchase."
                       styleClass="page-description"/>

                <GridPane hgap="10" vgap="10">

                    <Label text="Item Name"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="shoppingNameField"
                               promptText="Enter item name"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                    <Label text="Quantity"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="2"/>

                    <TextField fx:id="shoppingQuantityField"
                               promptText="Enter quantity"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="3"/>

                    <Label text="Unit"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="shoppingUnitField"
                               promptText="kg, litres, pieces..."
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                </GridPane>

                <HBox spacing="10">

                    <Button text="Add Item"
                            onAction="#addShoppingItem"
                            styleClass="action-button"/>

                    <Button text="Add Low Stock Items"
                            onAction="#addLowStockItems"
                            styleClass="action-button"/>

                    <Button text="Mark Purchased"
                            onAction="#markPurchased"
                            styleClass="action-button"/>

                    <Button text="Remove Selected"
                            onAction="#removeShoppingItem"
                            styleClass="delete-button"/>

                </HBox>

                <TableView fx:id="shoppingTable"
                           VBox.vgrow="ALWAYS">

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                    <columns>

                        <TableColumn fx:id="shoppingIdColumn"
                                     text="ID"
                                     prefWidth="60"/>

                        <TableColumn fx:id="shoppingItemColumn"
                                     text="Item Name"
                                     prefWidth="200"/>

                        <TableColumn fx:id="shoppingQtyColumn"
                                     text="Quantity"
                                     prefWidth="120"/>

                        <TableColumn fx:id="shoppingUnitColumn"
                                     text="Unit"
                                     prefWidth="120"/>

                        <TableColumn fx:id="purchasedColumn"
                                     text="Purchased"
                                     prefWidth="150"/>

                    </columns>

                </TableView>

            </VBox>

            <!-- RECIPES SECTION -->
            <VBox fx:id="recipesSection"
                  spacing="20"
                  visible="false"
                  managed="false">

                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>

                <Label text="Recipe Suggestions"
                       styleClass="page-title"/>

                <Label text="Discover recipes using ingredients available in your pantry."
                       styleClass="page-description"/>

                <Button text="Generate Recipe Suggestions"
                        onAction="#generateRecipes"
                        styleClass="action-button"/>

                <Label text="Available Recipes"
                       styleClass="section-title"/>

                <ListView fx:id="recipeList"
                          VBox.vgrow="ALWAYS"/>

            </VBox>

        </StackPane>
    </center>

</BorderPane>